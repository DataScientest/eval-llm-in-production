#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"

# Prevent recursion when this hook triggers the mirror push itself.
if [[ "${SYNCING_MIRROR:-0}" == "1" ]]; then
  exit 0
fi

# Only mirror pushes that target origin.
if [[ "$remote_name" != "origin" ]]; then
  exit 0
fi

should_sync=0
while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$local_ref" == "refs/heads/student" && "$remote_ref" == "refs/heads/student" ]]; then
    should_sync=1
    break
  fi
done

if [[ "$should_sync" != "1" ]]; then
  exit 0
fi

echo "post-push: syncing student to mirror/main"
SYNCING_MIRROR=1 git push --force-with-lease mirror refs/heads/student:refs/heads/main
